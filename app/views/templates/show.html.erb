<h1><%= @template.titulo %></h1>

<p><%= @template.descricao %></p>

<h3>Questões</h3>

<% @template.questoes.each do |q| %>
  <div>
    <p><strong><%= q.enunciado %></strong></p>
    <p>Tipo: <%= q.tipo %></p>

    <% if q.opcoes.any? %>
      <ul>
        <% q.opcoes.each do |o| %>
          <li><%= o.numero %> - <%= o.texto %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
<% end %>

<%= link_to "Voltar", templates_path %>
