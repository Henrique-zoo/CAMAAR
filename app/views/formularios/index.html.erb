<h1>Gerenciamento de Formulários</h1>

<% if @formularios.any? %>
  <table>
    <thead>
      <tr>
        <th>Template</th>
        <th>Turma</th>
        <th>Público-alvo</th>
        <th>Ação</th>
      </tr>
    </thead>
    <tbody>
      <% @formularios.each do |formulario| %>
        <tr>
          <td><%= formulario.template.titulo %></td>
          <td><%= formulario.turma.nome_exibicao %></td>
          <td><%= formulario.docentes? ? "Docentes" : "Discentes" %></td>
          <td>
            <%= button_to "Gerar Relatório de Respostas", "#", method: :get %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>Nenhum formulário criado para este semestre</p>
<% end %>
