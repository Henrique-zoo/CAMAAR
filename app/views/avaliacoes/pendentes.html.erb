<h1>Avaliações Pendentes</h1>

<% if @avaliacoes_pendentes.any? %>
  <table>
    <thead>
      <tr>
        <th>Turma</th>
        <th>Status</th>
        <th>Ação</th>
      </tr>
    </thead>
    <tbody>
      <% @avaliacoes_pendentes.each do |avaliacao| %>
        <tr>
          <td><%= avaliacao.formulario.turma.materia.nome %></td>
          <td>Não respondido</td>
          <td><%= link_to 'Responder', '#' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>Nenhum formulário pendente foi encontrado.</p>
<% end %>