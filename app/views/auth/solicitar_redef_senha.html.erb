<% if flash[:success] %>
  <div style="background-color: #d4edda; color: #155724; padding: 12px; border: 1px solid #c3e6cb; border-radius: 4px; margin: 20px auto; max-width: 350px; text-align: center; font-family: sans-serif;">
    <%= sanitize(flash[:success]) %>
  </div>
<% end %>

<% if flash[:error] %>
  <div style="background-color: #f8d7da; color: #721c24; padding: 12px; border: 1px solid #f5c6cb; border-radius: 4px; margin: 20px auto; max-width: 350px; text-align: center; font-family: sans-serif;">
    <%= flash[:error] %>
  </div>
<% end %>

<div class="container-autenticacao" style="display: flex; gap: 40px; align-items: center; justify-content: center; margin-top: 50px;">

  <div class="card-login" style="border: 1px solid #ccc; padding: 30px; border-radius: 8px; width: 350px;">

    <h2 style="margin-top: 0; margin-bottom: 20px; color: #333; font-size: 22px;">Recuperar Senha</h2>
    <p style="color: #666; font-size: 14px; margin-bottom: 20px;">
      Insira o e-mail associado à sua conta para receber as instruções de redefinição de senha.
    </p>

    <form action="<%= solicitar_redef_senha_path %>" method="POST">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

      <div class="campo-formulario" style="margin-bottom: 25px;">
        <label for="email" style="display: block; margin-bottom: 5px; font-weight: bold;">E-mail cadastrado:</label>
        <input type="email" id="email" name="email" placeholder="exemplo@gmail.com" style="width: 100%; padding: 8px; box-sizing: border-box;" autocomplete="email" required>
      </div>

      <button type="submit" style="width: 100%; padding: 12px; background-color: #007bff; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 14px;">
        Enviar e-mail de redefinição
      </button>

    </form>

    <div class="links-ajuda" style="margin-top: 20px; text-align: center; font-size: 14px;">
      <a href="<%= root_path %>" class="link-voltar">Voltar para o Login</a>
    </div>

  </div>

  <div class="boas-vindas-painel" style="max-width: 400px;">
    <h1 style="color: #333; font-size: 32px; margin-bottom: 10px;">CAMAAR</h1>
    <p style="color: #666; line-height: 1.5;">
      Por questões de segurança, os links de redefinição de senha expiram após um curto período de tempo. Se não receber o e-mail em alguns minutos, verifique sua caixa de spam.
    </p>
  </div>

</div>
