<% if flash[:success] %>
  <div style="background-color: #d4edda; color: #155724; padding: 12px; border: 1px solid #c3e6cb; border-radius: 4px; margin: 20px auto; max-width: 350px; text-align: center; font-family: sans-serif;">
    <%= sanitize(flash[:success]) %>
  </div>
<% end %>

<% if flash[:error] || flash[:alert] %>
  <div style="background-color: #f8d7da; color: #721c24; padding: 12px; border: 1px solid #f5c6cb; border-radius: 4px; margin: 20px auto; max-width: 350px; text-align: center; font-family: sans-serif;">
    <%= flash[:error] || flash[:alert] %>
  </div>
<% end %>

<div class="container-autenticacao" style="display: flex; gap: 40px; align-items: center; justify-content: center; margin-top: 50px;">

  <div class="card-login" style="border: 1px solid #ccc; padding: 30px; border-radius: 8px; width: 350px;">

    <form action="<%= login_path %>" method="POST">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

      <div class="campo-formulario" style="margin-bottom: 15px;">
        <label for="identificador" style="display: block; margin-bottom: 5px; font-weight: bold;">Matrícula ou E-mail:</label>
        <input type="text" id="identificador" name="identificador" placeholder="Digite seu e-mail ou matrícula" style="width: 100%; padding: 8px; box-sizing: border-box;" autocomplete="username" required>
      </div>

      <div class="campo-formulario" style="margin-bottom: 20px;">
        <label for="senha" style="display: block; margin-bottom: 5px; font-weight: bold;">Senha:</label>
        <input type="password" id="senha" name="senha" placeholder="Digite sua senha" style="width: 100%; padding: 8px; box-sizing: border-box;" autocomplete="current-password" required>
      </div>

      <button type="submit" style="width: 100%; padding: 10px; background-color: #007bff; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;">
        Entrar
      </button>

    </form>

    <div class="links-ajuda" style="margin-top: 20px; display: flex; flex-direction: column; gap: 10px; font-size: 14px;">
      <%= link_to "É sua primeira vez? Cadastre-se", cadastro_path, class: "link-cadastro" %>
      <%= link_to "Esqueceu sua senha? Redefinir senha", solicitar_redef_senha_path, class: "link-recuperacao" %>
    </div>

  </div>

  <div class="boas-vindas-painel" style="max-width: 400px;">
    <h1 style="color: #333; font-size: 32px; margin-bottom: 10px;">Bem-vindo ao CAMAAR</h1>
    <p style="color: #666; line-height: 1.5;">
      O sistema de gerenciamento e acompanhamento de atividades acadêmicas. Acesse sua conta ao lado para entrar no sistema.
    </p>
  </div>

</div>
